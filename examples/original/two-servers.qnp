& QRUNAP2 original teaching model: two parallel servers with a shared queue.
/DECLARE/
QUEUE INPUT, DESK;
/STATION/
NAME=INPUT;
TYPE=SOURCE;
SERVICE=EXP(0.75);
TRANSIT=DESK;
/STATION/
NAME=DESK;
TYPE=SERVER,MULTIPLE(2);
SERVICE=EXP(1);
TRANSIT=OUT;
/CONTROL/
TMAX=10000;
/EXEC/
BEGIN
SIMUL;
END;
/END/
